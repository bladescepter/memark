{
  "name": "memark",
  "version": "0.3.7",
  "description": "Markdown/Git long-term memory for the pi coding agent with reviewed recall and safe curator writes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bladescepter/memark.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "memory",
    "markdown"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && sh tests/run.sh"
  },
  "files": [
    "index.ts",
    "sync.ts",
    "snapshot.ts",
    "baseline.ts",
    "host-role.ts",
    "repo.ts",
    "curator.ts",
    "review-ui.ts",
    "diagnostics.ts",
    "metadata.ts",
    "async.ts",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "docs"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.19.19",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
