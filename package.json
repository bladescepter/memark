{
  "name": "memark",
  "version": "0.3.1",
  "description": "Markdown/Git long-term memory for the pi coding agent with reviewed recall and safe curator writes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bladescepter/memark.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "memory",
    "markdown"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && sh tests/run.sh"
  },
  "files": [
    "index.ts",
    "repo.ts",
    "curator.ts",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "docs"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.19",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
